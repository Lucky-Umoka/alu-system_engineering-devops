#!/usr/bin/env bash
# Installs nginx and adds a custom X-Served-By header with the server hostname
sudo apt-get update
sudo apt-get install -y nginx
if ! grep -q "X-Served-By" /etc/nginx/sites-available/default
then
  sudo sed -i "/server_name _;/a add_header X-Served-By $HOSTNAME;" /etc/nginx/sites-available/default
fi
sudo service nginx restart
