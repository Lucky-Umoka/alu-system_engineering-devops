#!/usr/bin/env bash
# Runs nginx as the nginx user and makes it listen on port 8080
sed -i 's/^#\?\s*user .*/user nginx;/' /etc/nginx/nginx.conf
chmod 644 /etc/nginx/nginx.conf
sed -i --follow-symlinks 's/\b80\b/8080/g' /etc/nginx/sites-enabled/default
pkill apache2
pkill nginx
su -s /bin/bash nginx -c "service nginx start"
